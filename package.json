{
  "name": "neko-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc -p tsconfig.playwright.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "doctor": "react-doctor --no-telemetry --blocking none",
    "doctor:changed": "react-doctor --no-telemetry --blocking none --diff main",
    "ui:audit": "bash scripts/impeccable-check.sh",
    "anonymize": "node scripts/anonymize-methodology.mjs",
    "build": "tsc && vite build",
    "build:windows": "bash scripts/build-windows.sh",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml && npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run e2e:typecheck && npm run test:run && npm run build && npm run rust:check && npm run privacy:scan && npm run ui:audit",
    "preview": "vite preview",
    "privacy:scan": "bash scripts/privacy-scan.sh",
    "seed:fixture": "sqlite3 neko-finance.db < scripts/seed-forecast-fixture.sql",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "react-doctor": "0.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
