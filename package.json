{
  "name": "neko-finance",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:lib-api-allowlist": "node scripts/check-lib-api-allowlist.mjs",
    "lint:android-oauth-client-id": "node scripts/check-android-oauth-client-id.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc -p tsconfig.playwright.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "doctor": "npx react-doctor@latest --no-telemetry",
    "doctor:changed": "npx react-doctor@latest --no-telemetry --scope changed",
    "ui:audit": "bash scripts/impeccable-check.sh",
    "anonymize": "node scripts/anonymize-methodology.mjs",
    "build": "tsc && vite build",
    "build:windows": "bash scripts/build-windows.sh",
    "build:android": "bash scripts/build-android.sh",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked && npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "comment:hygiene": "bash scripts/comment-hygiene.sh",
    "check": "npm run format:check && npm run lint && npm run lint:lib-api-allowlist && npm run lint:android-oauth-client-id && npm run typecheck && npm run e2e:typecheck && npm run test:run && npm run build && npm run rust:check && npm run privacy:scan && npm run comment:hygiene && npm run ui:audit",
    "preview": "vite preview",
    "privacy:scan": "bash scripts/privacy-scan.sh",
    "seed:fixture": "sqlite3 neko-finance.db < scripts/seed-forecast-fixture.sql",
    "deadcode": "npx --yes knip",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
