# Generated by Cargo when this crate is built standalone (e.g. `cargo clippy` run from inside
# this directory) instead of as part of the shell's build — the shell's own build always shares
# `src-tauri/target/` (already ignored there), regardless of this file.
/target/
# A library crate, not a binary — `src-tauri/Cargo.lock` (the app's) is the authoritative lock
# for the whole dependency graph, this one included; a second lockfile here would just drift.
Cargo.lock

# `build.rs` (via `tauri_plugin::Builder`) rewrites these on every build with docs/schema for
# the three commands — nothing reads them (the plugin has no JS-exposed API, no capability ever
# references a permission here), so they're pure build output, not source.
/permissions/autogenerated/
/permissions/schemas/
