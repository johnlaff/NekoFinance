{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/copilot/**",
              "components/core/**",
              "components/finance/**",
              "ui_kits/copilot/**",
              "ui_kits/dashboard/**",
              "ui_kits/methodology/**",
              "ui_kits/settings/**",
              "ui_kits/shared/**",
              "ui_kits/transactions/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|Geist Mono|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, Geist Mono, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalDiffCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sheet|range|changes|note|status|actions|className|key|ref|className|style|children)$/]",
        "message": "<ApprovalDiffCard> doesn't accept that prop. Declared props: title, sheet, range, changes, note, status, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalDiffCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pending|approved|rejected)$/]",
        "message": "<ApprovalDiffCard> status must be one of 'pending' | 'approved' | 'rejected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|square|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, square, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|warning|danger|info|primary)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'warning' | 'danger' | 'info' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|iconLeft|iconRight|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, iconLeft, iconRight, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|name|thinking|userInitials|children|className|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: from, name, thinking, userInitials, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:mia|user)$/]",
        "message": "<ChatBubble> from must be one of 'mia' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<CitationLine> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|title|description|action|skeletonRows|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: variant, icon, title, description, action, skeletonRows, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:empty|loading|skeleton|error)$/]",
        "message": "<EmptyState> variant must be one of 'empty' | 'loading' | 'skeleton' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|score|sublabel|size|className|key|ref|className|style|children)$/]",
        "message": "<HealthBadge> doesn't accept that prop. Declared props: level, score, sublabel, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:strong|steady|watch|risk)$/]",
        "message": "<HealthBadge> level must be one of 'strong' | 'steady' | 'watch' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<HealthBadge> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|prefix|suffix|icon|money|error|hint|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, required, prefix, suffix, icon, money, error, hint, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|delta|deltaDir|sublabel|spark|className|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, icon, delta, deltaDir, sublabel, spark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='deltaDir'] > Literal[value!=/^(?:up|down|flat)$/]",
        "message": "<MetricTile> deltaDir must be one of 'up' | 'down' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OwnerChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|role|bare|className|key|ref|className|style|children)$/]",
        "message": "<OwnerChip> doesn't accept that prop. Declared props: name, type, role, bare, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OwnerChip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:personal|partner|shared)$/]",
        "message": "<OwnerChip> type must be one of 'personal' | 'partner' | 'shared'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|dot|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|className|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|merchant|owner|amount|positive|status|confidence|selected|onClick|className|key|ref|className|style|children)$/]",
        "message": "<TransactionRow> doesn't accept that prop. Declared props: date, merchant, owner, amount, positive, status, confidence, selected, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:reconciled|imported|needs-owner)$/]",
        "message": "<TransactionRow> status must be one of 'reconciled' | 'imported' | 'needs-owner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionRow'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<TransactionRow> confidence must be one of 'high' | 'medium' | 'low'."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
