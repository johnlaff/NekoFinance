# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth PKCE (desktop application)
# Create credentials at https://console.cloud.google.com/auth/clients
# Use "Desktop app" type. The client id is read by the frontend at build time
# (VITE_ prefix) and forwarded to the Rust shell.
VITE_GOOGLE_CLIENT_ID=
# Client secret: optional for a desktop app (the flow uses PKCE — RFC 8252). It is
# NO LONGER bundled into the frontend JS. If your exchange requires it, set it WITHOUT
# the VITE_ prefix so only the Rust process (not the JS bundle) sees it.
GOOGLE_CLIENT_SECRET=

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
