# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth PKCE (desktop application)
# Create credentials at https://console.cloud.google.com/auth/clients
# Use "Desktop app" type. The VITE_ prefix is required: the frontend reads these
# at build time and forwards them to the Rust shell.
VITE_GOOGLE_CLIENT_ID=
# Optional in Google's installed-app token exchange; send it if the exchange
# rejects the request without it. Desktop-app secrets are not confidential,
# but keep this file local and gitignored anyway.
VITE_GOOGLE_CLIENT_SECRET=

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
