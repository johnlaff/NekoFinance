# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth (PKCE, loopback). Create credentials at
# https://console.cloud.google.com/auth/clients
#
# This repo uses a "Desktop app" OAuth client. Google still issues a client_secret for this
# client type and its token endpoint REQUIRES it on refresh — without it the connection drops
# after ~1h and you must reconnect every session. For installed desktop apps this "secret" is
# NOT confidential by Google's own definition (it inevitably ships inside the binary, and
# Google's docs assume this), so baking it at build time is within policy — and the public name
# says so, since a browser bundle cannot keep a secret. Both values are read at build time
# (VITE_ prefix) and forwarded to the Rust shell. See src/lib/api.ts.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_KEY=
# Optional local-dev fallback: the Rust process also reads GOOGLE_CLIENT_SECRET from its own
# environment when VITE_GOOGLE_DESKTOP_CLIENT_KEY is absent. Not present in the shipped .exe at runtime.
GOOGLE_CLIENT_SECRET=

# Android does NOT use any of the variables above. It authenticates with its own Google OAuth
# credential of type Android (package + SHA-1, no client secret — PKCE only), whose client id is
# a versioned constant (GOOGLE_ANDROID_CLIENT_ID in src/lib/env.ts, ANDROID_OAUTH_SCHEME in
# src-tauri/src/oauth/redirect.rs), never an env var: a build-time variable already shipped two
# broken Android builds when it landed empty or mistyped. See docs/building-android.md.

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
