# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth (PKCE, loopback). Create credentials at
# https://console.cloud.google.com/auth/clients
#
# This repo uses a "Web application" OAuth client, whose token endpoint REQUIRES the client_secret
# on refresh — without it the connection drops after ~1h and you must reconnect every session.
# For an INSTALLED desktop app the "secret" is NOT confidential: it inevitably ships inside the
# binary, and Google's own docs assume this. So BOTH values are read at build time (VITE_ prefix)
# and forwarded to the Rust shell. See src/lib/api.ts.
# (Alternative without a secret: switch the OAuth client to "Desktop app" type, whose refresh uses
#  PKCE only — then VITE_GOOGLE_CLIENT_SECRET can stay empty.)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
# Optional local-dev fallback: the Rust process also reads GOOGLE_CLIENT_SECRET from its own
# environment when VITE_GOOGLE_CLIENT_SECRET is absent. Not present in the shipped .exe at runtime.
GOOGLE_CLIENT_SECRET=

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
