# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth PKCE (desktop application)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Use "Desktop application" type. No client secret needed (PKCE flow).
GOOGLE_OAUTH_CLIENT_ID=

# Google Sheets: the spreadsheet ID from the URL
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
