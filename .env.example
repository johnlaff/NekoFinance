# Neko Finance local configuration template.
# Copy to .env locally. Do not commit real values.

# Google OAuth PKCE (desktop application)
# Create credentials at https://console.cloud.google.com/auth/clients
# Use "Desktop app" type. The client id is read by the frontend at build time
# (VITE_ prefix) and forwarded to the Rust shell.
VITE_GOOGLE_CLIENT_ID=
# Client secret: REQUIRED by Google's token endpoint for "Desktop app" clients (PKCE does NOT
# replace it for Google). Desktop secrets are not confidential per Google's docs. By default it is
# read here (frontend) and forwarded to the Rust shell, which sends it to Google.
VITE_GOOGLE_CLIENT_SECRET=
# Hardening alternative: leave VITE_GOOGLE_CLIENT_SECRET empty and set GOOGLE_CLIENT_SECRET (no
# VITE_ prefix) in the Rust process environment instead — the backend reads it from there, keeping
# the secret out of the JS bundle. The backend uses whichever is provided.
GOOGLE_CLIENT_SECRET=

# Keep methodology packs outside git. They must be anonymized before use.
METHODOLOGY_PACK_DIR=.methodology-pack
NEKO_DATA_DIR=.neko-data

# Provider keys are optional until the copilot slice is implemented.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
